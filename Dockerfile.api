FROM node:22.14-alpine

WORKDIR /app

# Set production environment
ENV NODE_ENV=production

# Install dependencies
COPY package*.json ./
COPY Patient-case-taking-software-/package*.json ./Patient-case-taking-software-/
COPY prisma/ ./prisma/

# Install dependencies, build frontend, and generate Prisma Client
RUN npm ci && cd Patient-case-taking-software- && npm ci && npm run build && cd .. && npx prisma generate --schema=prisma/schema.prisma

# Copy application code
COPY Patient-case-taking-software-/ ./Patient-case-taking-software-/
COPY docs/ ./docs/

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5000/api/health/live || exit 1

EXPOSE 5000

CMD ["node", "Patient-case-taking-software-/server.js"]
