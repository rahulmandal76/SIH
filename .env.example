# ==============================================================================
# UNIFIED HEALTHCARE PLATFORM - ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and provide your deployment-specific keys.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# --- APPLICATION PORTS & HOSTING ---
PORT=5000
VITE_PORT=5173
STREAMLIT_PORT=8501
RAG_SERVICE_PORT=8000
NODE_ENV=development

# --- CANONICAL DATABASE (PRISMA) ---
# Production: PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/medsync_db?schema=public
# Local Development (SQLite): file:./dev.db
DATABASE_URL="file:./dev.db"

# --- AI & LLM PROVIDER CREDENTIALS ---
# Google Gemini API Key (Used by backend proxy for Kiosk clinical intake interview)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (Used by Python RAG service for longitudinal clinical history generation)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# --- EMBEDDINGS & VECTOR STORE CONFIGURATION ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_INDEX_DIR=vector_index

# --- ABDM / ABHA INTEGRATION (LEVEL 2 - WHEN OFFICIAL CREDENTIALS ARE AVAILABLE) ---
# Keep empty or set to SANDBOX for development
ABDM_ENV=SANDBOX
ABDM_CLIENT_ID=your_abdm_client_id_here
ABDM_CLIENT_SECRET=your_abdm_client_secret_here
