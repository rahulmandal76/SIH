# ==============================================================================
# UNIFIED HEALTHCARE PLATFORM - ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and provide your deployment-specific keys.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# --- APPLICATION PORTS & HOSTING ---
PORT=5000
VITE_PORT=5173
STREAMLIT_PORT=8501
RAG_SERVICE_PORT=8000
NODE_ENV=development

# --- CANONICAL DATABASE (PRISMA) ---
# Production: PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/medsync_db?schema=public
# Local Development (SQLite): file:./dev.db
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER=sqlite

# --- SECURITY & AUTHENTICATION ---
# Session & CSRF Security (Provide a 64-byte random hex string in production)
SESSION_SECRET=replace_me_with_a_long_secure_random_hex_string
# Internal Authentication (Node <-> Python secure bridge)
RAG_SERVICE_INTERNAL_TOKEN=replace_me_with_internal_secure_token

# --- CORS CONFIGURATION ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# --- RATE LIMITING ---
AI_RATE_LIMIT_WINDOW_MS=600000
AI_RATE_LIMIT_MAX=30

# --- AI & LLM PROVIDER CREDENTIALS ---
# Google Gemini API Key (Used by backend proxy for Kiosk clinical intake interview)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (Used by Python RAG service for longitudinal clinical history generation)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# --- EMBEDDINGS & VECTOR STORE CONFIGURATION ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_INDEX_DIR=./aiml-crash-yash-verma-Aurahealth_final_project (1)/aiml-crash-yash-verma-Aurahealth_final_project/vector_index

# --- ABDM / ABHA INTEGRATION (LEVEL 2 - WHEN OFFICIAL CREDENTIALS ARE AVAILABLE) ---
# Keep empty or set to SANDBOX for development
ABDM_ENV=SANDBOX
ABDM_CLIENT_ID=your_abdm_client_id_here
ABDM_CLIENT_SECRET=your_abdm_client_secret_here

# --- PHASE 13 PRODUCTION AI & RUNTIME VECTOR CONFIGURATION ---
DOCUMENT_AI_PROVIDER=gemini
DOCUMENT_AI_MODEL=gemini-2.5-flash
DOCUMENT_AI_TIMEOUT_MS=15000
DOCUMENT_AI_MAX_RETRIES=3
VECTOR_INDEX_ROOT=./storage/vector_index
TESSERACT_CMD=tesseract
TESSDATA_PREFIX=
